# Projeto do Xcode gerado pelo XcodeGen e artefatos de build
ios/*.xcodeproj
.build/
node_modules/

# Vídeo, áudio e imagem nunca entram no git (HC-7, P-3)
*.mp4
*.mov
*.wav
*.aiff
*.aif
*.m4a
*.caf
*.png
*.jpg
*.jpeg
*.heic

# Resultados e sessões do XCTest (o .xctestrun leva o token de sessão)
*.xcresult
*.xctestrun

# Registros
*.log
*.ndjson

# Chaves, certificados e perfis de provisionamento (P-3)
*.p8
*.p12
*.mobileprovision
*.cer

# Saídas dos spikes
spikes/sp-*/out/

# Machine configuration, secrets and local tooling state
.env
.env.*
!.env.example
config/local*.json
config/*.local.json
.mcp.local.json
.DS_Store
*.pem
*.key
*.keystore
.swiftpm/
DerivedData/
coverage/

# Keep new session notes and local choreographies private (tracked history is unchanged)
.claude/handoffs/
.hermes/
choreographies/local/
